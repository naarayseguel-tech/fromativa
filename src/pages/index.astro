---
import Navbar from "../components/navbar.astro";
import Footer from "../components/footer.astro";
import "../styles/global.css";

const areas = [
	{
		icono: "🎤",
		titulo: "Batallas de freestyle",
		descripcion:
			"Descubre cómo los MC se enfrentan con ingenio, improvisación y rimas que sorprenden al público.",
		enlace: "/blog",
		clase: "rosa",
	},
	{
		icono: "🎧",
		titulo: "Cultura hip-hop",
		descripcion:
			"Conoce la música, el arte urbano y las expresiones culturales que dan vida al movimiento hip-hop.",
		enlace: "/sobre-mi",
		clase: "celeste",
	},
	{
		icono: "🏆",
		titulo: "Grandes competiciones",
		descripcion:
			"Explora los torneos, los enfrentamientos memorables y los talentos que destacan en el freestyle.",
		enlace: "/blog",
		clase: "amarillo",
	},
];
---

<Navbar />

<main id="inicio">
	<section class="hero">
		<div class="hero-contenido">
			<p class="etiqueta">⚡ BIENVENIDO AL MUNDO DEL FREESTYLE ⚡</p>
			<h1>RIMAS QUE IMPACTAN.<span>BARRAS QUE HACEN HISTORIA.</span></h1>
			<p class="introduccion">
				El escenario está listo. Descubre las batallas de rap, conoce la
				cultura urbana y déjate llevar por la creatividad de quienes
				convierten cada palabra en un espectáculo.
			</p>
			<div class="acciones">
				<a class="boton boton-blanco" href="/blog">Explorar el blog →</a
				>
				<a class="boton boton-borde" href="/sobre-mi"
					>Conocer la cultura</a
				>
			</div>
			<div class="frase">
				<span>IMPROVISACIÓN</span><b>✦</b><span>CREATIVIDAD</span><b
					>✦</b
				><span>ACTITUD</span>
			</div>
		</div>
		<div class="hero-arte" aria-label="Micrófono de rap decorativo">
			<span class="corona">♛</span>
			<div class="microfono">🎤</div>
			<span class="rap">¡RAP!</span>
			<span class="calle">LA CALLE<br />TAMBIÉN ES<br />ESCENARIO</span>
			<span class="destello destello-uno">✦</span>
			<span class="destello destello-dos">✧</span>
		</div>
	</section>

	<section class="cultura">
		<div class="encabezado-seccion">
			<div>
				<p class="etiqueta etiqueta-rosa">MUCHO MÁS QUE RIMAS</p>
				<h2>La cultura que mueve <span>el escenario.</span></h2>
			</div>
			<p class="texto-intro">
				El freestyle es una forma de expresión que combina ritmo,
				ingenio, confianza y pasión. Cada batalla es una oportunidad
				para demostrar talento, creatividad y personalidad.
			</p>
		</div>

		<div class="rejilla">
			{
				areas.map((area) => (
					<article class={`tarjeta-area ${area.clase}`}>
						<div class="icono-area" aria-hidden="true">
							{area.icono}
						</div>
						<h3>{area.titulo}</h3>
						<p>{area.descripcion}</p>
						<a href={area.enlace}>Ver más →</a>
						<span class="decoracion" aria-hidden="true">
							✦
						</span>
					</article>
				))
			}
		</div>
	</section>

	<section class="banner">
		<div class="banner-corona" aria-hidden="true">♛</div>
		<div class="banner-titulo">
			<h2>¿LISTO PARA ENTRAR <span>EN EL UNIVERSO DEL RAP?</span></h2>
		</div>
		<div class="banner-texto">
			<p>
				Aprende, descubre nuevos talentos y disfruta de una cultura en
				la que cada rima puede marcar la diferencia.
			</p>
			<a class="boton boton-blanco" href="/contacto">Contáctanos ✉</a>
		</div>
	</section>
</main>

<Footer />

<style>
	.hero {
		position: relative;
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		align-items: center;
		min-height: 450px;
		margin-top: 0.8rem;
		padding: 3rem 2.7rem;
		overflow: hidden;
		border-radius: 0 0 28px 28px;
		background: linear-gradient(
			115deg,
			#ff0095 0%,
			#ff315e 40%,
			#ffb800 72%,
			#00cfff 100%
		);
		color: white;
	}
	.hero-contenido {
		position: relative;
		z-index: 2;
	}
	.etiqueta {
		display: inline-block;
		margin: 0 0 1rem;
		padding: 0.4rem 0.8rem;
		background: #fff000;
		color: #211039;
		font-size: 0.78rem;
		font-weight: 900;
		letter-spacing: 0.4px;
		transform: rotate(-1deg);
	}
	.hero h1 {
		margin: 0.3rem 0 1rem;
		color: white;
		font-size: clamp(2.4rem, 4.8vw, 4.4rem);
		line-height: 1.02;
		letter-spacing: -2px;
		font-weight: 900;
		text-shadow: 0 4px 0 #b90068;
	}
	.hero h1 span {
		display: block;
		color: #fff000;
		text-shadow: 0 4px 0 #d84900;
	}
	.introduccion {
		max-width: 580px;
		color: white;
		font-weight: 600;
		line-height: 1.65;
	}
	.acciones {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		margin-top: 1.5rem;
	}
	.boton {
		display: inline-block;
		padding: 0.85rem 1.3rem;
		border-radius: 40px;
		font-weight: 900;
		text-decoration: none;
		transition: transform 0.2s;
	}
	.boton:hover {
		transform: translateY(-3px);
	}
	.boton-blanco {
		background: white;
		color: #ed007e;
	}
	.boton-borde {
		border: 2px solid white;
		color: white;
	}
	.frase {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		margin-top: 2rem;
		color: white;
		font-size: 0.72rem;
		font-weight: 900;
		letter-spacing: 1.4px;
	}
	.frase b {
		color: #fff000;
	}
	.hero-arte {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 340px;
	}
	.microfono {
		display: grid;
		place-items: center;
		width: min(260px, 80%);
		aspect-ratio: 1;
		border: 7px solid white;
		border-radius: 50%;
		background: linear-gradient(145deg, #702cff, #00cfff);
		font-size: clamp(6rem, 12vw, 9rem);
		transform: rotate(-9deg);
		box-shadow:
			12px 15px 0 #ff007f,
			0 20px 40px #5c003e55;
	}
	.rap {
		position: absolute;
		right: 0;
		bottom: 30px;
		color: white;
		font-size: clamp(2.5rem, 5vw, 4rem);
		font-weight: 900;
		font-style: italic;
		transform: rotate(-10deg);
		text-shadow: 4px 4px 0 #702cff;
	}
	.corona {
		position: absolute;
		top: 0;
		right: 12%;
		color: #fff000;
		font-size: 5rem;
		transform: rotate(10deg);
	}
	.calle {
		position: absolute;
		right: -5px;
		bottom: 5px;
		padding: 0.8rem;
		background: #fff000;
		color: #251039;
		font-size: 0.7rem;
		font-weight: 900;
		text-align: center;
		transform: rotate(7deg);
	}
	.destello {
		position: absolute;
		color: white;
		font-size: 3rem;
	}
	.destello-uno {
		left: 5%;
		top: 12%;
	}
	.destello-dos {
		left: 8%;
		bottom: 15%;
		color: #fff000;
	}
	.cultura {
		padding: 3.5rem 0 2rem;
	}
	.encabezado-seccion {
		display: grid;
		grid-template-columns: 1fr 0.85fr;
		align-items: center;
		gap: 2rem;
		margin-bottom: 1.8rem;
	}
	.etiqueta-rosa {
		background: #ff3cac;
		color: white;
	}
	.encabezado-seccion h2 {
		margin: 0;
		color: #20103f;
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.1;
	}
	.encabezado-seccion h2 span {
		display: block;
		color: #ff007f;
		font-style: italic;
	}
	.texto-intro {
		color: #392b55;
		line-height: 1.8;
	}
	.rejilla {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.1rem;
	}
	.tarjeta-area {
		position: relative;
		overflow: hidden;
		padding: 1.4rem;
		border: 2px solid;
		border-radius: 18px;
		background: white;
		transition:
			transform 0.2s,
			box-shadow 0.2s;
	}
	.tarjeta-area:hover {
		transform: translateY(-6px);
		box-shadow: 0 12px 28px #702cff20;
	}
	.tarjeta-area.rosa {
		border-color: #ff0095;
		background: linear-gradient(145deg, #fff, #fff0f8);
	}
	.tarjeta-area.celeste {
		border-color: #00cfff;
		background: linear-gradient(145deg, #fff, #e8fbff);
	}
	.tarjeta-area.amarillo {
		border-color: #ffc400;
		background: linear-gradient(145deg, #fff, #fffbe5);
	}
	.icono-area {
		display: grid;
		place-items: center;
		width: 62px;
		height: 62px;
		border-radius: 50%;
		background: #ff0095;
		font-size: 2rem;
	}
	.celeste .icono-area {
		background: #00cfff;
	}
	.amarillo .icono-area {
		background: #ffc400;
	}
	.tarjeta-area h3 {
		margin: 0.9rem 0 0.5rem;
		color: #251039;
		font-size: 1.2rem;
		text-transform: uppercase;
	}
	.tarjeta-area p {
		color: #392b55;
		line-height: 1.6;
	}
	.tarjeta-area a {
		display: inline-block;
		margin-top: 0.5rem;
		color: #e9007a;
		font-weight: 900;
		text-decoration: none;
	}
	.celeste a {
		color: #008fb7;
	}
	.amarillo a {
		color: #a66b00;
	}
	.decoracion {
		position: absolute;
		top: 8px;
		right: 15px;
		color: #ff0095;
		font-size: 3rem;
		opacity: 0.3;
	}
	.celeste .decoracion {
		color: #00bde8;
	}
	.amarillo .decoracion {
		color: #e6b800;
	}
	.banner {
		display: grid;
		grid-template-columns: auto 1.1fr 1fr;
		align-items: center;
		gap: 1.2rem;
		margin: 2rem 0 3rem;
		padding: 1.7rem;
		border: 3px solid white;
		border-radius: 22px;
		background: linear-gradient(110deg, #4214ff, #d900e8, #ff007f, #ffb800);
		color: white;
	}
	.banner-corona {
		color: #fff000;
		font-size: 3.5rem;
	}
	.banner-titulo h2 {
		margin: 0;
		color: white;
		font-size: clamp(1.3rem, 2.5vw, 2rem);
		font-style: italic;
		line-height: 1.15;
	}
	.banner-titulo h2 span {
		display: block;
		color: #fff000;
	}
	.banner-texto p {
		color: white;
		line-height: 1.6;
	}
	@media (max-width: 800px) {
		.hero {
			grid-template-columns: 1fr;
			padding: 2.2rem 1.4rem;
		}
		.hero-arte {
			min-height: 260px;
		}
		.microfono {
			width: 190px;
		}
		.encabezado-seccion {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}
		.rejilla {
			grid-template-columns: 1fr;
		}
		.banner {
			grid-template-columns: auto 1fr;
		}
		.banner-texto {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 480px) {
		.hero h1 {
			font-size: 2.4rem;
			letter-spacing: -1px;
		}
		.frase {
			font-size: 0.65rem;
			gap: 0.45rem;
		}
	}
</style>
