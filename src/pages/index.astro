---
import Layout from "../layouts/Layout.astro";

const batallas = [
	{
		numero: "01",
		icono: "🔥",
		titulo: "Batallas de rap",
		descripcion:
			"Enfrentamientos llenos de energía, ingenio y grandes rimas.",
		enlace: "#batallas",
	},
	{
		numero: "02",
		icono: "🎤",
		titulo: "Freestyle",
		descripcion:
			"El arte de improvisar, responder y sorprender con creatividad.",
		enlace: "#freestyle",
	},
	{
		numero: "03",
		icono: "🏆",
		titulo: "Campeones",
		descripcion:
			"Conoce el talento y la pasión de los grandes exponentes del rap.",
		enlace: "#campeones",
	},
];
---

<Layout title="Zona Freestyle | Batallas de Rap">
	<header class="encabezado">
		<a class="logo" href="#inicio">ZONA <span>FREESTYLE</span></a>

		<nav aria-label="Menú principal">
			<a href="#inicio">Inicio</a>
			<a href="#batallas">Batallas</a>
			<a href="#freestyle">Freestyle</a>
			<a href="#campeones">Campeones</a>
		</nav>
	</header>

	<main>
		<section class="portada" id="inicio">
			<div class="portada-contenido">
				<p class="etiqueta">🎤 CULTURA URBANA · RIMAS · TALENTO</p>

				<h1>EL PODER DE LA <span>PALABRA</span></h1>

				<p class="introduccion">
					El escenario está listo. Descubre las batallas de rap,
					conoce la cultura urbana y déjate llevar por la creatividad
					de quienes convierten cada palabra en un espectáculo.
				</p>

				<div class="botones">
					<a class="boton boton-principal" href="#batallas"
						>Explorar batallas ↗</a
					>
					<a class="boton boton-secundario" href="#freestyle"
						>Conocer el freestyle</a
					>
				</div>

				<div class="estadisticas">
					<div>
						<strong>100 %</strong>
						<span>Creatividad</span>
					</div>
					<div>
						<strong>1 VS 1</strong>
						<span>Competencia</span>
					</div>
					<div>
						<strong>∞</strong>
						<span>Imaginación</span>
					</div>
				</div>
			</div>

			<div class="portada-arte" aria-label="Decoración de micrófono">
				<div class="circulo circulo-grande"></div>
				<div class="circulo circulo-pequeno"></div>
				<div class="microfono">🎤</div>

				<div class="arte-texto">
					RIMA<br />
					CON<br />
					<span>ACTITUD</span>
				</div>

				<span class="estrella estrella-uno">✦</span>
				<span class="estrella estrella-dos">✧</span>

				<div class="sello">FLOW<br />LIBRE</div>
			</div>
		</section>

		<section class="seccion" id="batallas">
			<div class="titulo-seccion">
				<p class="etiqueta">DESCUBRE ESTE UNIVERSO</p>
				<h2>EL MUNDO DEL <span>RAP</span></h2>
				<p>Ritmo, ingenio y pasión en cada enfrentamiento.</p>
			</div>

			<div class="tarjetas">
				{
					batallas.map((batalla) => (
						<article class="tarjeta">
							<div class="tarjeta-superior">
								<span class="numero">{batalla.numero}</span>
								<span class="icono">{batalla.icono}</span>
							</div>

							<h3>{batalla.titulo}</h3>
							<p>{batalla.descripcion}</p>

							<a class="enlace-tarjeta" href={batalla.enlace}>
								Descubrir más →
							</a>
						</article>
					))
				}
			</div>
		</section>

		<section class="seccion freestyle" id="freestyle">
			<div class="freestyle-icono">🎧</div>

			<div class="freestyle-contenido">
				<p class="etiqueta">SIN GUIONES, SIN LÍMITES</p>
				<h2>¿QUÉ ES EL <span>FREESTYLE?</span></h2>

				<p>
					El freestyle es una forma de expresión en la que los
					participantes improvisan rimas en el momento. Para destacar,
					utilizan su ingenio, ritmo, memoria y capacidad de
					respuesta.
				</p>

				<p>
					Cada batalla es diferente. La creatividad, la confianza y el
					respeto son parte importante de la cultura del rap.
				</p>
			</div>
		</section>

		<section class="seccion campeones" id="campeones">
			<p class="etiqueta">EL TALENTO MARCA LA DIFERENCIA</p>
			<h2>EL ESCENARIO ES <span>TUYO</span></h2>
			<p>Descubre, aprende y disfruta de la cultura urbana.</p>
			<a href="#inicio" class="boton boton-principal"
				>Volver al inicio ↑</a
			>
		</section>
	</main>

	<footer class="pie">
		<a class="logo" href="#inicio">ZONA <span>FREESTYLE</span></a>
		<p>La cultura se expresa con palabras. 🎤</p>
		<p class="copyright">© 2026 Zona Freestyle · Proyecto educativo</p>
	</footer>
</Layout>

<style>
	:global(:root) {
		--fondo: #10091f;
		--panel: #211333;
		--rosa: #ff36a8;
		--morado: #a855f7;
		--celeste: #42e8ff;
		--blanco: #ffffff;
		--texto: #e4dced;
	}

	.encabezado {
		position: sticky;
		top: 0;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 25px;
		padding: 20px 7%;
		background: #170e29;
		border-bottom: 1px solid #43275d;
	}

	.logo {
		color: var(--blanco);
		font-size: 1.2rem;
		font-weight: 900;
		letter-spacing: -1px;
		white-space: nowrap;
	}

	.logo span {
		color: var(--rosa);
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 24px;
	}

	nav a {
		color: var(--texto);
		font-size: 0.85rem;
		font-weight: bold;
		transition: color 0.2s;
	}

	nav a:hover {
		color: var(--celeste);
	}

	.portada {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		align-items: center;
		gap: 35px;
		min-height: 610px;
		padding: 65px 8%;
		overflow: hidden;
		background:
			radial-gradient(ellipse at 85% 45%, #62218c 0%, transparent 40%),
			radial-gradient(ellipse at 10% 10%, #401451 0%, transparent 40%),
			var(--fondo);
	}

	.portada-contenido {
		max-width: 650px;
	}

	.etiqueta {
		color: var(--celeste);
		font-size: 0.76rem;
		font-weight: 800;
		letter-spacing: 1.7px;
	}

	h1 {
		margin: 20px 0;
		font-size: clamp(2.8rem, 6vw, 5.3rem);
		font-weight: 900;
		line-height: 1.05;
		letter-spacing: -2px;
	}

	h1 span,
	h2 span {
		color: var(--rosa);
	}

	.introduccion {
		max-width: 560px;
		color: var(--texto);
		font-size: 1rem;
	}

	.botones {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 28px;
	}

	.boton {
		display: inline-block;
		padding: 13px 20px;
		border-radius: 10px;
		font-size: 0.85rem;
		font-weight: 800;
		transition:
			transform 0.2s,
			box-shadow 0.2s;
	}

	.boton:hover {
		transform: translateY(-3px);
		box-shadow: 0 8px 25px #ff36a850;
	}

	.boton-principal {
		background: linear-gradient(110deg, var(--rosa), var(--morado));
		color: var(--blanco);
	}

	.boton-secundario {
		border: 1px solid var(--morado);
		background: #ffffff08;
	}

	.estadisticas {
		display: flex;
		flex-wrap: wrap;
		gap: 34px;
		margin-top: 38px;
	}

	.estadisticas div {
		display: flex;
		flex-direction: column;
	}

	.estadisticas strong {
		color: var(--celeste);
		font-size: 1.35rem;
	}

	.estadisticas span {
		color: #cbbfda;
		font-size: 0.76rem;
	}

	.portada-arte {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 390px;
	}

	.circulo {
		position: absolute;
		border-radius: 50%;
	}

	.circulo-grande {
		width: 300px;
		height: 300px;
		border: 2px solid #ff36a880;
		background: linear-gradient(145deg, #ff36a845, #a855f735);
		box-shadow: 0 0 65px #a855f740;
	}

	.circulo-pequeno {
		width: 235px;
		height: 235px;
		border: 2px dashed #42e8ff99;
	}

	.microfono {
		position: absolute;
		top: 22px;
		right: 22px;
		font-size: 4rem;
		transform: rotate(15deg);
		filter: drop-shadow(0 0 18px #ff36a8);
	}

	.arte-texto {
		z-index: 1;
		font-size: 2.7rem;
		font-weight: 900;
		line-height: 1.1;
		text-align: center;
		transform: rotate(-8deg);
		text-shadow: 4px 5px 0 #a855f7;
	}

	.arte-texto span {
		color: var(--celeste);
	}

	.estrella {
		position: absolute;
		color: var(--rosa);
		font-size: 3rem;
	}

	.estrella-uno {
		top: 30px;
		left: 12px;
	}

	.estrella-dos {
		right: 5px;
		bottom: 30px;
		color: var(--celeste);
	}

	.sello {
		position: absolute;
		bottom: 20px;
		left: 12px;
		padding: 14px;
		border: 2px solid var(--celeste);
		border-radius: 50%;
		color: var(--celeste);
		font-size: 0.7rem;
		font-weight: 900;
		line-height: 1.4;
		text-align: center;
		transform: rotate(-12deg);
	}

	.seccion {
		padding: 80px 8%;
	}

	.titulo-seccion {
		max-width: 650px;
		margin: 0 auto 40px;
		text-align: center;
	}

	h2 {
		margin: 12px 0;
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 900;
		line-height: 1.2;
	}

	.titulo-seccion > p:last-child,
	.campeones > p:not(.etiqueta),
	.freestyle-contenido > p:not(.etiqueta) {
		color: var(--texto);
	}

	.tarjetas {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 22px;
	}

	.tarjeta {
		padding: 25px;
		border: 1px solid #563476;
		border-radius: 18px;
		background: linear-gradient(145deg, #2a1742, #191128);
		transition:
			transform 0.25s,
			border-color 0.25s;
	}

	.tarjeta:hover {
		transform: translateY(-7px);
		border-color: var(--rosa);
	}

	.tarjeta-superior {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.numero {
		color: var(--celeste);
		font-size: 0.85rem;
		font-weight: 900;
	}

	.icono {
		font-size: 2.1rem;
	}

	.tarjeta h3 {
		margin: 20px 0 10px;
		font-size: 1.2rem;
	}

	.tarjeta p {
		min-height: 85px;
		color: var(--texto);
		font-size: 0.88rem;
	}

	.enlace-tarjeta {
		display: inline-block;
		margin-top: 10px;
		color: var(--rosa);
		font-size: 0.85rem;
		font-weight: 800;
	}

	.freestyle {
		display: grid;
		grid-template-columns: 0.35fr 1fr;
		align-items: center;
		gap: 40px;
		border-top: 1px solid #563476;
		border-bottom: 1px solid #563476;
		background: linear-gradient(110deg, #29103e, #171027);
	}

	.freestyle-icono {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 150px;
		height: 150px;
		border: 2px solid var(--rosa);
		border-radius: 35px;
		background: linear-gradient(145deg, #ff36a835, #a855f735);
		font-size: 4rem;
		box-shadow: 0 0 35px #a855f730;
	}

	.campeones {
		text-align: center;
		background:
			radial-gradient(ellipse at center, #57217c55, transparent 65%),
			var(--fondo);
	}

	.campeones .boton {
		margin-top: 15px;
	}

	.pie {
		padding: 35px 7%;
		border-top: 1px solid #392252;
		background: #170e29;
		text-align: center;
	}

	.pie p {
		color: var(--texto);
		font-size: 0.85rem;
	}

	.pie .copyright {
		margin-top: 20px;
		color: #9385a9;
		font-size: 0.75rem;
	}

	@media (max-width: 800px) {
		.encabezado {
			flex-direction: column;
		}

		nav {
			justify-content: center;
			gap: 14px;
		}

		.portada {
			grid-template-columns: 1fr;
			padding: 50px 7%;
		}

		.portada-arte {
			min-height: 340px;
		}

		.tarjetas {
			grid-template-columns: 1fr;
		}

		.tarjeta p {
			min-height: 0;
		}

		.freestyle {
			grid-template-columns: 1fr;
		}

		.freestyle-icono {
			width: 110px;
			height: 110px;
			font-size: 3rem;
		}

		h1 {
			letter-spacing: -1px;
		}
	}

	@media (max-width: 420px) {
		.botones {
			flex-direction: column;
		}

		.boton {
			text-align: center;
		}

		.estadisticas {
			justify-content: space-between;
			gap: 15px;
		}

		.circulo-grande {
			width: 250px;
			height: 250px;
		}

		.circulo-pequeno {
			width: 195px;
			height: 195px;
		}

		.arte-texto {
			font-size: 2.2rem;
		}
	}
</style>
